# LiteStream Backend Environment Template
# Copy this file to .env and modify as needed

# Server Config
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=postgres
DB_USER=root
DB_PASSWORD=secret
DB_NAME=litestream
DB_PORT=5432

# Redis
REDIS_ADDR=redis:6379

# JWT Config
JWT_SECRET=supersecret

# AWS / S3 (LocalStack or AWS)
AWS_REGION=us-east-1
S3_BUCKET_NAME=vod-bucket
S3_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Media Settings
# For local development with LocalStack, this points to localhost:4566
# For production, this should point to your CloudFront distribution (e.g. https://cdn.yourdomain.com/vod-bucket)
PUBLIC_VOD_BASE_URL=http://localhost:4566/vod-bucket
