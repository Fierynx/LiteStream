# LiteStream Backend Environment Template
# Copy this file to .env and modify as needed

# Server Config
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=postgres
DB_USER=root
DB_PASSWORD=secret
DB_NAME=litestream
DB_PORT=5432

# Redis
REDIS_ADDR=redis:6379

# JWT Config
JWT_SECRET=supersecret

# NOTE: AWS configuration (Access Key, Secret, Region) and 
# Infrastructure configuration (S3 Bucket, VOD URL, SQS Queue) 
# are now dynamically managed via the Admin Dashboard.
